# The package is governed by repo-tools/tools/distribution.json. Keep repository tooling,
# historical evidence, and command examples out of the user distribution.
/.github/
/examples/
/repo-tools/

# Moon always excludes _build; these rules make the policy explicit for other
# generated and local-only paths as well.
/_build/
/target/
/.mooncakes/
/coverage.xml
/coverage/
/coverage-*.xml
/*.coverage
/*.profraw
/*.zip

# Repository test suites, fixtures, benchmarks and private tests.
/tests/
**/*_wbtest.mbt
