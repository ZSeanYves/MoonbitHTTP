import {
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonbitlang/core/async/fs",
  "ZSeanYves/http/runtime/transport",
  "ZSeanYves/http/adapter/native/server" @native_server,
  "ZSeanYves/http/application/server" @server_api,
  "ZSeanYves/http/adapter/native/tls" @tls_native,
  "moonbitlang/core/async",
  "moonbitlang/core/async/socket",
  "ZSeanYves/http/runtime/service",
  "ZSeanYves/http/protocol/http2",
  "ZSeanYves/http/core/body",
  "ZSeanYves/http/core/types",
}

supported_targets = "+native"

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/socket",
  ],
)
