import {
  "ZSeanYves/http/internal/async_support",
  "moonbitlang/core/async",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/debug",
  "moonbitlang/core/int64",
  "moonbitlang/core/encoding/utf8",
  "ZSeanYves/http/runtime/transport",
  "ZSeanYves/http/core/types",
  "ZSeanYves/http/policy/cache",
  "ZSeanYves/http/policy/cookie",
  "ZSeanYves/http/protocol/http1",
  "ZSeanYves/http/protocol/http2",
  "ZSeanYves/http/core/body",
  "ZSeanYves/http/policy/auth",
  "ZSeanYves/http/policy/content_coding",
  "ZSeanYves/http/runtime/service",
}

supported_targets = "js+native+wasm+wasm-gc"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/cond_var",
  ],
  "is-main": false,
)
