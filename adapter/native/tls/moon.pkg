import {
  "ZSeanYves/MoonbitHTTP/core/types",
  "moonbitlang/async",
  "moonbitlang/async/tls" @async_tls,
  "moonbitlang/core/encoding/utf8",
  "ZSeanYves/MoonbitHTTP/runtime/transport",
  "ZSeanYves/MoonbitHTTP/adapter/native/transport" @transport_native,
}

supported_targets = "+native"

import {
  "ZSeanYves/MoonbitHTTP/protocol/tls",
  "moonbitlang/async/fs",
  "moonbitlang/async/socket",
  "ZSeanYves/MoonbitHTTP/protocol/quic",
  "ZSeanYves/MoonbitHTTP/internal/test_support",
} for "wbtest"

options(
  "native-stub": [
    "openssl_stub.c",
    "quic_tls_stub.c",
    "revocation_test_stub.c",
  ],
  "is-main": false,
)
