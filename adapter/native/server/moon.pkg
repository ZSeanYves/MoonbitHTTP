import {
  "ZSeanYves/MoonbitHTTP/internal/async_support",
  "ZSeanYves/MoonbitHTTP/core/types",
  "ZSeanYves/MoonbitHTTP/core/body",
  "ZSeanYves/MoonbitHTTP/runtime/service",
  "moonbitlang/core/async",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/aqueue",
  "ZSeanYves/MoonbitHTTP/protocol/quic",
  "ZSeanYves/MoonbitHTTP/protocol/http3",
  "ZSeanYves/MoonbitHTTP/adapter/native/tls" @tls_native,
  "ZSeanYves/MoonbitHTTP/adapter/native/transport" @transport_native,
  "ZSeanYves/MoonbitHTTP/application/server" @server_api,
  "ZSeanYves/MoonbitHTTP/runtime/transport",
}

supported_targets = "+native"

import {
  "moonbitlang/core/async/fs",
  "ZSeanYves/MoonbitHTTP/adapter/native/client" @client_native,
} for "wbtest"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/socket",
  ],
  "is-main": false,
)
