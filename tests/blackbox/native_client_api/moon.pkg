import {
  "moonbitlang/core/async",
  "ZSeanYves/http/adapter/native/client",
  "ZSeanYves/http/application/client" @client_api,
  "ZSeanYves/http/core/types",
  "ZSeanYves/http/policy/content_coding",
  "ZSeanYves/http/runtime/transport",
} for "test"

supported_targets = "+native"

