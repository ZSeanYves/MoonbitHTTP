import {
  "moonbitlang/core/async",
  "ZSeanYves/MoonbitHTTP/adapter/native/client",
  "ZSeanYves/MoonbitHTTP/adapter/native/tls" @tls_native,
  "ZSeanYves/MoonbitHTTP/adapter/native/transport" @transport_native,
  "ZSeanYves/MoonbitHTTP/core/types",
  "ZSeanYves/MoonbitHTTP/policy/content_coding",
  "ZSeanYves/MoonbitHTTP/runtime/transport",
} for "test"

supported_targets = "+native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
