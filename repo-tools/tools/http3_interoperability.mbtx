///|
import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/async@0.20.2/socket",
  "moonbitlang/core/env",
  "moonbitlang/x@0.4.47/crypto",
}

///|
async fn record(
  directory : String,
  name : String,
  command : String,
  args : Array[String],
  success? : Bool = true,
) -> String {
  let stdout = @process.redirect_to_file(
    directory + "/" + name + ".stdout",
    create_mode=CreateNew,
  )
  let stderr = @process.redirect_to_file(
    directory + "/" + name + ".stderr",
    create_mode=CreateNew,
  )
  // Redirect first so a timeout also preserves the independent client's logs.
  let exit = @async.with_timeout_opt(30000, async fn() {
    @process.run(
      command,
      args,
      stdout~,
      stderr~,
      cancel_handler=@process.graceful_cancel(timeout=1000),
    )
  })
  let status = exit.unwrap_or(-1)
  let stdout_text = @fs.read_file(directory + "/" + name + ".stdout").text()
  let stderr_text = @fs.read_file(directory + "/" + name + ".stderr").text()
  let command_record : Json = {
    "program": command,
    "arguments": args,
    "exit": status,
    "timed_out": exit is None,
    "timeout_ms": 30000,
  }
  @fs.write_file(
    directory + "/" + name + ".command.json",
    command_record,
    create_mode=CreateNew,
  )
  if exit is None {
    fail("\{name} exceeded 30 seconds; process was cancelled and reaped")
  }
  if success && status != 0 {
    fail("\{name} exited \{status}: \{stderr_text}")
  }
  if !success && status == 0 {
    fail("\{name} unexpectedly accepted the invalid certificate")
  }
  stdout_text + stderr_text
}

///|
fn decimal(value : StringView) -> Int raise {
  guard !value.is_empty() else { fail("expected a decimal value") }
  let mut result = 0
  for byte in value {
    guard byte >= '0' && byte <= '9' else {
      fail("expected a non-negative decimal value")
    }
    guard result <= (2147483647 - byte.to_int() + 48) / 10 else {
      fail("decimal value is too large")
    }
    result = result * 10 + byte.to_int() - 48
  }
  result
}

///|
struct QueuedDatagram {
  sequence : Int
  bytes : Bytes
  due_tick : Int
  received_ms : UInt64
}

///|
struct ProxyDirection {
  label : String
  pending : Array[QueuedDatagram]
  mut received : Int
  mut forwarded : Int
  mut dropped_initial : Int
  mut dropped_handshake : Int
  mut dropped_periodic : Int
  mut delayed : Int
  mut reordered : Int
  mut last_forwarded : Int
  mut max_pending : Int
  mut max_delay_ms : Int64
}

///|
fn ProxyDirection::new(label : String) -> ProxyDirection {
  {
    label,
    pending: [],
    received: 0,
    forwarded: 0,
    dropped_initial: 0,
    dropped_handshake: 0,
    dropped_periodic: 0,
    delayed: 0,
    reordered: 0,
    last_forwarded: 0,
    max_pending: 0,
    max_delay_ms: 0L,
  }
}

///|
fn ProxyDirection::summary(self : ProxyDirection) -> Json {
  {
    "received": self.received,
    "forwarded": self.forwarded,
    "dropped_initial": self.dropped_initial,
    "dropped_handshake": self.dropped_handshake,
    "dropped_application_periodic": self.dropped_periodic,
    "delayed": self.delayed,
    "observed_reordering": self.reordered,
    "pending_at_shutdown": self.pending.length(),
    "maximum_pending": self.max_pending,
    "maximum_forward_delay_ms": self.max_delay_ms,
  }
}

///|
struct ProxyState {
  client : ProxyDirection
  server : ProxyDirection
  events : Array[Json]
  mut peer : @socket.Addr?
  mut tick : Int
}

///|
// Packet type bits are not header protected. A coalesced datagram is classified
// by its first packet; parsed long-header lengths locate a coalesced Handshake.
fn datagram_kind(bytes : Bytes) -> String {
  if bytes.length() == 0 {
    return "empty"
  }
  match bytes[0].to_int() & 0xf0 {
    0xc0 => "initial"
    0xd0 => "0rtt"
    0xe0 => "handshake"
    0xf0 => "retry"
    _ => "application"
  }
}

///|
// A server often coalesces Initial and Handshake packets in one UDP datagram.
// Parse only the public long-header lengths; encrypted payload bytes are never
// treated as packet headers, so a random 0xe0 byte cannot fake Handshake loss.
fn read_varint(bytes : Bytes, offset : Int) -> (Int64, Int)? {
  if offset >= bytes.length() {
    return None
  }
  let first = bytes[offset].to_int()
  let width = match first >> 6 {
    0 => 1
    1 => 2
    2 => 4
    _ => 8
  }
  if offset + width > bytes.length() {
    return None
  }
  let mut value : Int64 = (first & 0x3f).to_int64()
  for index in 1..<width {
    value = (value << 8) | bytes[offset + index].to_int().to_int64()
  }
  Some((value, width))
}

///|
fn packet_end(bytes : Bytes, offset : Int) -> (Int, Int)? {
  if offset + 6 > bytes.length() || (bytes[offset].to_int() & 0x80) == 0 {
    return None
  }
  let first = bytes[offset].to_int()
  let version = (bytes[offset + 1].to_int() << 24) |
    (bytes[offset + 2].to_int() << 16) |
    (bytes[offset + 3].to_int() << 8) |
    bytes[offset + 4].to_int()
  if version == 0 {
    return None
  }
  let dcid_length = bytes[offset + 5].to_int()
  let mut cursor = offset + 6 + dcid_length
  if cursor >= bytes.length() {
    return None
  }
  let scid_length = bytes[cursor].to_int()
  cursor += 1 + scid_length
  if cursor > bytes.length() {
    return None
  }
  let packet_type = (first >> 4) & 3
  if packet_type == 3 {
    return Some((packet_type, bytes.length()))
  }
  if packet_type == 0 {
    let (token_length, used) = match read_varint(bytes, cursor) {
      Some(value) => value
      None => return None
    }
    cursor += used + token_length.to_int()
  }
  let (payload_length, used) = match read_varint(bytes, cursor) {
    Some(value) => value
    None => return None
  }
  cursor += used + payload_length.to_int()
  if cursor > bytes.length() {
    None
  } else {
    Some((packet_type, cursor))
  }
}

///|
fn contains_packet_type(bytes : Bytes, packet_type : Int) -> Bool {
  let mut offset = 0
  while offset < bytes.length() {
    match packet_end(bytes, offset) {
      Some((kind, end)) => {
        if kind == packet_type {
          return true
        }
        if end <= offset {
          return false
        }
        offset = end
      }
      None => return false
    }
  }
  false
}

///|
fn ProxyState::enqueue(
  self : ProxyState,
  direction : ProxyDirection,
  bytes : Bytes,
) -> Unit raise {
  direction.received += 1
  let sequence = direction.received
  let kind = datagram_kind(bytes)
  let has_handshake = contains_packet_type(bytes, 2)
  let action = if kind == "initial" && direction.dropped_initial == 0 {
    direction.dropped_initial += 1
    "drop-first-initial"
  } else if direction.label == "server-to-client" &&
    has_handshake &&
    direction.dropped_handshake == 0 {
    direction.dropped_handshake += 1
    "drop-first-server-handshake"
  } else if kind == "application" && sequence % 11 == 0 {
    direction.dropped_periodic += 1
    "drop-periodic-application"
  } else {
    guard direction.pending.length() < 1024 else {
      fail("impairment proxy queue limit exceeded")
    }
    // Hold every second datagram for four 5 ms ticks. The following odd
    // sequence can overtake it, giving deterministic reorder evidence while
    // leaving a bounded 20 ms delay budget.
    let delay_ticks = if sequence % 2 == 0 { 4 } else { 0 }
    if delay_ticks > 0 {
      direction.delayed += 1
    }
    direction.pending.push({
      sequence,
      bytes,
      due_tick: self.tick + delay_ticks,
      received_ms: @env.now(),
    })
    direction.max_pending = direction.max_pending.max(
      direction.pending.length(),
    )
    if delay_ticks > 0 {
      "delay-20ms"
    } else {
      "enqueue"
    }
  }
  self.events.push({
    "direction": direction.label,
    "sequence": sequence,
    "action": action,
    "first_packet_kind": kind,
    "contains_handshake_header": has_handshake,
    "bytes": bytes.length(),
    "tick": self.tick,
  })
}

///|
async fn ProxyState::flush(
  self : ProxyState,
  direction : ProxyDirection,
  send : async (Bytes) -> Unit,
) -> Unit {
  let mut index = 0
  while index < direction.pending.length() {
    let packet = direction.pending[index]
    if packet.due_tick > self.tick {
      index += 1
      continue
    }
    ignore(direction.pending.remove(index))
    send(packet.bytes)
    let reordered = packet.sequence < direction.last_forwarded
    if reordered {
      direction.reordered += 1
    }
    direction.last_forwarded = direction.last_forwarded.max(packet.sequence)
    direction.forwarded += 1
    direction.max_delay_ms = direction.max_delay_ms.max(
      (@env.now() - packet.received_ms).reinterpret_as_int64(),
    )
    self.events.push({
      "direction": direction.label,
      "sequence": packet.sequence,
      "action": "forward",
      "tick": self.tick,
      "overtaken_by_later_datagram": reordered,
    })
  }
}

///|
// One invocation of the unmodified upstream client uses one QUIC connection.
// Give every invocation its own front and upstream sockets; no mapping can
// accidentally reuse a previous client's server-side endpoint.
async fn with_impairment(
  directory : String,
  name : String,
  summaries : Array[Json],
  run : async (String) -> String,
) -> String {
  let front = @socket.UdpServer(@socket.Addr::parse("127.0.0.1:0"))
  defer front.close()
  let upstream = @socket.UdpClient(@socket.Addr::parse("127.0.0.1:18443"))
  defer upstream.close()
  let state : ProxyState = {
    client: ProxyDirection::new("client-to-server"),
    server: ProxyDirection::new("server-to-client"),
    events: [],
    peer: None,
    tick: 0,
  }
  let result : Result[String, Error] = Ok(
    @async.with_task_group(async fn(group) {
      group.spawn_bg(
        async fn() {
          let buffer = FixedArray::make(65536, b'\x00')
          while true {
            let (length, peer) = front.recvfrom(buffer)
            match state.peer {
              None => state.peer = Some(peer)
              Some(expected) =>
                if peer != expected {
                  fail(
                    "a second UDP client entered a single-client proxy session",
                  )
                }
            }
            state.enqueue(state.client, Bytes::from_array(buffer[:length]))
          }
        },
        no_wait=true,
      )
      group.spawn_bg(
        async fn() {
          let buffer = FixedArray::make(65536, b'\x00')
          while true {
            let length = upstream.recv(buffer)
            state.enqueue(state.server, Bytes::from_array(buffer[:length]))
          }
        },
        no_wait=true,
      )
      group.spawn_bg(
        async fn() {
          while true {
            @async.sleep(5)
            state.tick += 1
            state.flush(state.client, async fn(bytes) { upstream.send(bytes) })
            if state.peer is Some(peer) {
              state.flush(state.server, async fn(bytes) {
                front.sendto(bytes, peer)
              })
            }
          }
        },
        no_wait=true,
      )
      let output = run("https://127.0.0.1:" + front.addr.port().to_string())
      // Let the bounded delay queue drain after the client's close flight.
      @async.sleep(30)
      state.tick += 8
      state.flush(state.client, async fn(bytes) { upstream.send(bytes) })
      if state.peer is Some(peer) {
        state.flush(state.server, async fn(bytes) { front.sendto(bytes, peer) })
      }
      output
    }),
  ) catch {
    error => Err(error)
  }
  let summary : Json = {
    "case": name,
    "client_endpoint": match state.peer {
      Some(peer) => peer.to_string()
      None => "none"
    },
    "proxy_endpoint": front.addr.to_string(),
    "upstream_endpoint": upstream.addr.to_string(),
    "client_to_server": state.client.summary(),
    "server_to_client": state.server.summary(),
    "cleanup": "all proxy tasks cancelled and joined before socket close",
  }
  summaries.push(summary)
  let proxy_evidence : Json = {
    "summary": summary,
    "events": Json::array(state.events),
    "profile": "first Initial loss each direction; first server Handshake loss; every 11th Application datagram lost; every 2nd remaining datagram delayed 20ms with a 5ms flush tick",
    "classification": "first QUIC packet type and parsed public long-header lengths across coalesced packets; encrypted payload bytes are skipped",
  }
  @fs.write_file(
    directory + "/" + name + ".proxy.json",
    proxy_evidence,
    create_mode=CreateNew,
  )
  match result {
    Ok(output) => {
      guard state.client.dropped_initial > 0 else {
        fail("\{name}: impairment proxy did not observe a client Initial to drop")
      }
      guard state.server.dropped_initial > 0 && state.server.dropped_handshake > 0 else {
        fail("\{name}: impairment proxy did not observe both server Initial and Handshake loss")
      }
      guard state.client.delayed > 0 && state.server.delayed > 0 else {
        fail("\{name}: impairment proxy did not exercise bounded delay in both directions")
      }
      guard state.client.reordered > 0 && state.server.reordered > 0 else {
        fail("\{name}: impairment proxy did not observe reordering in both directions")
      }
      guard state.client.pending.is_empty() && state.server.pending.is_empty() else {
        fail("\{name}: impairment proxy did not drain its bounded delay queues")
      }
      output
    }
    Err(error) => raise error
  }
}

///|
async fn request_case(
  directory : String,
  name : String,
  python : String,
  client : String,
  paths : Array[String],
  extras : Array[String],
  expected_body : String?,
  impair : Bool,
  summaries : Array[Json],
  include_headers? : Bool = false,
) -> Unit {
  let case_dir = directory + "/" + name
  @fs.mkdir(case_dir)
  let invoke = async fn(origin) {
    record(
      directory,
      name,
      python,
      [
        client,
        "--ca-certs",
        if expected_body is Some(_) {
          "adapter/native/tls/testdata/localhost.cert.pem"
        } else {
          "adapter/native/tls/testdata/other.cert.pem"
        },
        "--verbose",
        "--output-dir",
        case_dir,
        "--quic-log",
        case_dir,
      ] +
      (if include_headers { ["--include"] } else { [] }) +
      extras +
      paths.map(fn(path) { if path == "/" { origin } else { origin + path } }),
      success=expected_body is Some(_),
    )
  }
  let logs = if impair {
    with_impairment(directory, name, summaries, invoke)
  } else {
    invoke("https://127.0.0.1:18443")
  }
  match expected_body {
    Some(body) => {
      let expected = if include_headers {
        ":status: 200\r\ncontent-type: text/plain\r\ncontent-length: " +
        body.length().to_string() +
        "\r\n\r\n" +
        body
      } else {
        body
      }
      for path in paths {
        let filename = if path == "/" {
          "index.html"
        } else {
          path[1:].to_owned()
        }
        let response = @fs.read_file(case_dir + "/" + filename).text()
        guard response == expected else {
          fail("\{name}\{path}: incomplete or incorrect response")
        }
      }
      guard logs.contains("ALPN negotiated protocol h3") &&
        logs.contains("Response received") else {
        fail("\{name} did not complete an authenticated h3 response")
      }
      if extras.contains("--key-update") &&
        !logs.contains("Requesting key update") {
        fail("independent client did not request key update")
      }
    }
    None =>
      if !logs.contains("certificate") ||
        logs.contains("Response received") ||
        @fs.exists(case_dir + "/index.html") {
        fail("wrong-CA case did not fail at certificate verification")
      }
  }
}

///|
async fn main {
  let args = @env.args()
  let mut python = "_build/interop-aioquic/venv/bin/python"
  let mut client = "_build/interop-aioquic/upstream/examples/http3_client.py"
  let mut server_path = "_build/native/debug/build/examples/cmd/h3_smoke_server/h3_smoke_server.exe"
  let mut build_server = true
  let mut long_requests = 0
  let mut concurrent_requests = 0
  let mut duration_seconds = 0
  let mut impair = false
  let mut index = 1
  while index < args.length() {
    match args[index] {
      "--impair" => {
        impair = true
        index += 1
        continue
      }
      _ => ()
    }
    if index + 1 >= args.length() {
      fail("expected option value")
    }
    match args[index] {
      "--python" => python = args[index + 1]
      "--client" => client = args[index + 1]
      "--server" => {
        server_path = args[index + 1]
        build_server = false
      }
      "--long-requests" => long_requests = decimal(args[index + 1])
      "--concurrent-requests" => concurrent_requests = decimal(args[index + 1])
      "--duration-seconds" => duration_seconds = decimal(args[index + 1])
      _ =>
        fail(
          "usage: http3_interoperability.mbtx [--python PATH] [--client PATH] [--server PATH] [--long-requests N] [--duration-seconds N] [--concurrent-requests N] [--impair]",
        )
    }
    index += 2
  }
  if build_server {
    let status = @process.run("moon", [
      "build", "examples/cmd/h3_smoke_server", "--target", "native", "--deny-warn", "--warn-list",
      "+73",
    ])
    if status != 0 {
      fail("HTTP/3 smoke server build failed")
    }
  }
  if long_requests < 0 || long_requests > 3600 {
    fail("--long-requests must be between 0 and 3600")
  }
  if concurrent_requests < 0 || concurrent_requests > 32 {
    fail("--concurrent-requests must be between 0 and 32")
  }
  if duration_seconds < 0 || duration_seconds > 3600 {
    fail("--duration-seconds must be between 0 and 3600")
  }
  let temporary = @fs.tmpdir(prefix="moonbithttp-h3-interop")
  let unique = temporary.split("/").to_array().last().unwrap().to_owned()
  @fs.rmdir(temporary)
  let directory = "_build/evidence/http3-interoperability/" + unique
  @fs.mkdir(directory, recursive=true)
  println("HTTP/3 interoperability evidence: \{directory}")
  let revision = record(directory, "git-revision", "git", ["rev-parse", "HEAD"])
  let status = record(directory, "git-status", "git", [
    "status", "--porcelain=v1", "--untracked-files=all",
  ])
  let source = match client.strip_suffix("/examples/http3_client.py") {
    Some(value) => value.to_owned()
    None => fail("client must be the pinned upstream examples/http3_client.py")
  }
  let upstream = record(directory, "aioquic-revision", "git", [
    "-C", source, "rev-parse", "HEAD",
  ])
  if upstream.trim() != "cb103537126bbcc58752fd5bc7c8ac88bf552c01" {
    fail("aioquic example is not the pinned 1.3.0 commit")
  }
  let dependencies = record(directory, "python-dependencies", python, [
    "-m", "pip", "freeze",
  ])
  if !dependencies.contains("aioquic==1.3.0\n") {
    fail("aioquic 1.3.0 is required")
  }
  ignore(record(directory, "python-version", python, ["--version"]))
  ignore(record(directory, "openssl-version", "openssl", ["version", "-a"]))
  ignore(record(directory, "moon-version", "moon", ["version", "--all"]))
  let server_hash = @crypto.bytes_to_hex_string(
    @crypto.sha256(@fs.read_file(server_path).binary()),
  )
  let source_hash = @crypto.bytes_to_hex_string(
    @crypto.sha256(@fs.read_file(client).binary()),
  )
  if source_hash !=
    "7eab21d50460f0b4f55a18f110bd5d1901e336fef8f4ca5597d8794f1d2381bc" {
    fail("upstream aioquic HTTP/3 client source was modified")
  }
  let reservation = @socket.UdpServer(@socket.Addr::parse("127.0.0.1:18443"))
  reservation.close()
  @async.with_task_group(async fn(group) {
    let stdout = @process.redirect_to_file(
      directory + "/server.stdout",
      create_mode=CreateNew,
    )
    let stderr = @process.redirect_to_file(
      directory + "/server.stderr",
      create_mode=CreateNew,
    )
    let executable = if server_path.has_prefix("/") {
      server_path
    } else {
      "./" + server_path
    }
    let server = @process.spawn(
      group,
      executable,
      [],
      stdout~,
      stderr~,
      cancel_handler=@process.graceful_cancel(timeout=1000),
      no_wait=true,
    )
    defer server.cancel()
    @async.sleep(200)
    if server.try_wait() is Some(_) {
      fail("HTTP/3 smoke server exited before testing")
    }
    let proxy_summaries : Array[Json] = []
    request_case(
      directory,
      "get",
      python,
      client,
      ["/"],
      [],
      Some("MoonbitHTTP HTTP/3 smoke\n"),
      impair,
      proxy_summaries,
      include_headers=true,
    )
    request_case(
      directory,
      "post",
      python,
      client,
      ["/"],
      ["--data", "independent-http3-echo"],
      Some("independent-http3-echo"),
      impair,
      proxy_summaries,
      include_headers=true,
    )
    request_case(
      directory,
      "key-update",
      python,
      client,
      ["/"],
      ["--key-update"],
      Some("MoonbitHTTP HTTP/3 smoke\n"),
      impair,
      proxy_summaries,
      include_headers=true,
    )
    let mut long_completed = 0
    let mut concurrent_completed = 0
    if concurrent_requests > 0 {
      let paths : Array[String] = []
      for request_id in 0..<concurrent_requests {
        paths.push("/concurrent-" + request_id.to_string())
      }
      request_case(
        directory,
        "concurrent",
        python,
        client,
        paths,
        [],
        Some("MoonbitHTTP HTTP/3 smoke\n"),
        impair,
        proxy_summaries,
      )
      concurrent_completed = concurrent_requests
    }
    let window_start = @env.now()
    let window_deadline = window_start + duration_seconds.to_uint64() * 1000UL
    let mut window_completed = 0
    let mut window_index = 0
    while window_index < long_requests ||
          (duration_seconds > 0 && @env.now() < window_deadline) {
      let case_name = "long-" + window_index.to_string()
      request_case(
        directory,
        case_name,
        python,
        client,
        ["/"],
        [],
        Some("MoonbitHTTP HTTP/3 smoke\n"),
        impair,
        proxy_summaries,
      )
      long_completed += 1
      window_completed += 1
      window_index += 1
      if duration_seconds > 0 &&
        window_index >= long_requests &&
        @env.now() >= window_deadline {
        break
      }
    }
    let window_elapsed_ms = (@env.now() - window_start).reinterpret_as_int64()
    request_case(
      directory,
      "wrong-ca",
      python,
      client,
      ["/"],
      [],
      None,
      false,
      proxy_summaries,
    )
    if server.try_wait() is Some(_) {
      fail("HTTP/3 smoke server exited during testing")
    }
    server.cancel()
    let stopped : Result[Int, Error] = Ok(server.wait()) catch {
      error => Err(error)
    }
    ignore(stopped)
    let evidence : Json = {
      "status": "passed",
      "git_revision": revision.trim().to_owned(),
      "worktree_dirty": !status.is_empty(),
      "server_sha256": server_hash,
      "server_origin": if build_server {
        "built-from-current-worktree"
      } else {
        "caller-supplied-executable"
      },
      "upstream_commit": upstream.trim().to_owned(),
      "client_source_sha256": source_hash,
      "cases": ["http3-get", "http3-post", "http3-key-update", "http3-wrong-ca"],
      "long_requests_requested": long_requests,
      "long_requests_completed": long_completed,
      "concurrent_requests_requested": concurrent_requests,
      "concurrent_requests_completed": concurrent_completed,
      "duration_seconds_requested": duration_seconds,
      "duration_window_elapsed_ms": window_elapsed_ms,
      "duration_window_requests_completed": window_completed,
      "impairment_enabled": impair,
      "proxy_sessions": Json::array(proxy_summaries),
      "long_request_scope": "repeated authenticated aioquic HTTP/3 requests; concurrent batch uses one aioquic connection and concurrent request streams",
      "certificate_hostname_negative": "covered by native provider tests; upstream CLI has no SNI override",
      "long_duration_loss_pressure": if impair {
        "repeated authenticated requests through a deterministic loopback UDP loss/reorder proxy"
      } else if duration_seconds > 0 {
        "duration-based authenticated request window without injected network impairment"
      } else {
        "not requested by this run; use --duration-seconds and/or --impair"
      },
    }
    @fs.write_file(directory + "/result.json", evidence, create_mode=CreateNew)
  })
  println(
    "PASS: independent aioquic HTTP/3 smoke, certificate rejection, and requested long window",
  )
}
