----
import {
  "moonbitlang/async@0.22.10",
  "moonbitlang/async@0.22.10/fs",
  "moonbitlang/async@0.22.10/process",
}
----

///|
async fn run(program : String, arguments : Array[String]) -> Unit {
  let status = @process.run(program, arguments)
  if status != 0 { fail("\{program} exited \{status}") }
}

///|
async fn main {
  let directory = "_build/interop-aioquic"
  if !@fs.exists(directory) {
    @fs.mkdir(directory, recursive=true)
  }
  let python = directory + "/venv/bin/python"
  if !@fs.exists(python) {
    run("python3", ["-m", "venv", directory + "/venv"])
  }
  run(python, ["-m", "pip", "install", "-r", "repo-tools/tools/http3-requirements.txt"])
  let (status, output, _) = @process.collect_output(python, ["-c", "from importlib.metadata import version; print(version('aioquic'))"])
  guard status == 0 else { fail("could not read the installed aioquic version") }
  let tag = output.text().trim().to_owned()
  let upstream = directory + "/upstream"
  if !@fs.exists(upstream + "/.git") {
    run("git", ["clone", "--depth", "1", "--branch", tag, "https://github.com/aiortc/aioquic.git", upstream])
  } else {
    let (code, current, _) = @process.collect_output("git", ["-C", upstream, "describe", "--tags", "--exact-match", "HEAD"])
    if code != 0 || current.text().trim() != tag {
      run("git", ["-C", upstream, "fetch", "--depth", "1", "origin", "refs/tags/" + tag])
      run("git", ["-C", upstream, "switch", "--detach", "FETCH_HEAD"])
    }
  }
  println("Independent aioquic client and server examples ready")
}
