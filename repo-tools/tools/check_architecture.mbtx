----
import {
  "moonbitlang/async@0.22.10",
  "moonbitlang/async@0.22.10/fs",
  "moonbitlang/core/env",
}
----

///|
struct Dependency {
  source : String
  target : String
  kind : String
}

///|
fn manifest_imports(source : String, package_name : String) -> Array[Dependency] raise {
  let prefix = "ZSeanYves/MoonbitHTTP/"
  let dependencies : Array[Dependency] = []
  let block : Array[String] = []
  let mut importing = false
  for raw in source.split("\n") {
    let line = raw.trim()
    if line.is_empty() || line.has_prefix("//") { continue }
    if line.has_prefix("import") {
      guard line == "import {" && !importing else {
        fail("\{package_name}/moon.pkg: unsupported import layout; keep imports in explicit blocks")
      }
      importing = true
      continue
    }
    if !importing { continue }
    if line.has_prefix("}") {
      let kind = match line {
        "}" => "main"
        "} for \"test\"" => "test"
        "} for \"wbtest\"" => "wbtest"
        _ => fail("\{package_name}/moon.pkg: unsupported import target \{line}")
      }
      for target in block { dependencies.push({ source: package_name, target, kind }) }
      block.clear()
      importing = false
      continue
    }
    guard line.has_prefix("\"") else { fail("\{package_name}/moon.pkg: unrecognized import entry \{line}") }
    let parts = line.split("\"").to_array()
    guard parts.length() >= 3 else { fail("\{package_name}/moon.pkg: unterminated import") }
    let path = parts[1]
    if path.has_prefix(prefix) {
      block.push(path[prefix.length():].to_owned())
    } else { block.push("external:" + path.to_owned()) }
  }
  guard !importing else { fail("\{package_name}/moon.pkg: unterminated import block") }
  dependencies
}

///|
fn protocol_or_driver(package_name : String) -> Bool {
  package_name.has_prefix("protocol/") ||
    package_name == "runtime/service" ||
    package_name == "application/client" ||
    package_name == "application/server"
}

///|
fn check_edge(edge : Dependency, native_only : Bool) -> Unit raise {
  let source = edge.source
  let target = edge.target
  let violation = match source {
    "core/types" | "core/codec" => true
    "core/body" => target != "core/types"
    "runtime/transport" | "runtime/detection" => target != "core/types"
    "internal/packet_crypto" => true
    "protocol/tls" => target != "runtime/transport" && target != "internal/packet_crypto"
    "protocol/http1" | "protocol/http2" | "protocol/http3" | "protocol/quic" if edge.kind == "main" =>
      !(target == "core/codec" || target == "core/types" || target == "internal/http_fields" ||
        (source == "protocol/http3" && target == "protocol/quic") ||
        (source == "protocol/quic" && (target == "protocol/tls" || target == "runtime/transport" || target == "internal/packet_crypto")))
    "policy/auth" | "policy/cookie" | "policy/cache" | "policy/content_coding" =>
      protocol_or_driver(target)
    _ => false
  }
  guard !violation else {
    fail("forbidden \{edge.kind} dependency: \{source} -> \{target}")
  }
  guard !(source == "protocol/http3" && target == "protocol/http2") else {
    fail("HTTP/3 must import shared primitives from codec, not HTTP/2")
  }
  guard target != "io" && !target.has_prefix("io/") else {
    fail("removed io facade imported by \{source}")
  }
  if !source.has_prefix("tests/") && target.has_prefix("tests/") {
    fail("production package imports a repository test package: \{source} -> \{target}")
  }
  let portable = !source.has_prefix("adapter/native/") && !source.has_prefix("examples/") &&
    !(source.has_prefix("tests/") && native_only)
  guard !(portable && target.has_prefix("adapter/native/")) else {
    fail("portable package \{source} imports Native adapter \{target} (\{edge.kind})")
  }
}

///|
async fn main {
  let arguments = @env.args()
  let write = arguments.length() == 2 && arguments[1] == "--write"
  guard arguments.length() == 1 || write else {
    fail("usage: moon run repo-tools/tools/check_architecture.mbtx [--write]")
  }
  let packages : Array[String] = []
  @fs.walk(".", (path, entries) => {
    if entries.contains("moon.pkg") {
      let dir = if path.has_prefix("./") { path[2:].to_owned() } else { path }
      for file in entries {
        if file.has_suffix("_bench.mbt") && dir != "tests/benchmarks" {
          fail("put benchmarks under tests/benchmarks: \{dir}/\{file}")
        }
      }
      packages.push(dir)
    }
  }, exclude=fn(path) {
    path.split("/").any(fn(part) {
      part == ".git" || part == ".mooncakes" || part == "_build" || part == "target"
    })
  })
  packages.sort()
  guard !packages.is_empty() else { fail("no moon.pkg files found; run from the module root") }
  let edges : Set[String] = Set([])
  for package_name in packages {
    guard package_name != "io" && !package_name.has_prefix("io/") else { fail("removed io facade is still present") }
    let manifest = @fs.read_file(package_name + "/moon.pkg").text()
    let native_only = manifest.split("\n").any(fn(line) { line.trim() == "supported_targets = \"+native\"" })
    for edge in manifest_imports(manifest, package_name) {
      if (package_name.has_prefix("tests/blackbox/") || package_name.has_prefix("tests/integration/")) && edge.kind != "test" {
        fail("import suite dependencies for \"test\": \{package_name} -> \{edge.target}")
      }
      if edge.target.has_prefix("external:") {
        let target = edge.target[9:].to_owned()
        if edge.kind == "main" && (package_name.has_prefix("protocol/") || package_name == "core/types" ||
            package_name == "core/codec" || package_name == "internal/http_fields" || package_name == "internal/packet_crypto" || package_name == "runtime/transport") {
          let allowed = match target {
            "moonbitlang/core/buffer" | "moonbitlang/core/debug" | "moonbitlang/core/deque" |
            "moonbitlang/core/encoding/utf8" | "moonbitlang/core/int" | "moonbitlang/core/int64" | "moonbitlang/core/string" => true
            "moonbitlang/core/async" => package_name == "runtime/transport"
            "mizchi/experimental_crypto/hkdf" | "mizchi/experimental_crypto/aead" => package_name == "internal/packet_crypto"
            _ => false
          }
          guard allowed else { fail("unreviewed external protocol dependency: \{package_name} -> \{target}") }
        }
        continue
      }
      guard packages.contains(edge.target) else { fail("missing local package: \{package_name} -> \{edge.target}") }
      check_edge(edge, native_only)
      edges.add(edge.source + " " + edge.kind + " " + edge.target)
    }
  }
  let imports = edges.iter().to_array()
  imports.sort()
  let snapshot = "[packages]\n" + packages.join("\n") +
    "\n\n[imports: source kind target]\n" + imports.join("\n") + "\n"
  let path = "repo-tools/tools/package-dependencies.txt"
  if write {
    @fs.write_file(path, snapshot, create_mode=CreateOrTruncate)
  } else {
    guard @fs.exists(path) && @fs.read_file(path).text() == snapshot else {
      fail("package dependency snapshot is stale; run moon run repo-tools/tools/check_architecture.mbtx -- --write")
    }
  }
  println("PASS: \{packages.length()} package manifests, \{edges.length()} local dependency edges; architecture boundaries checked.")
}
