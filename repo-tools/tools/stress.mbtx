import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/socket",
  "moonbitlang/core/bench",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
struct Counters {
  mut stop : Bool
  mut attempts : Int
  mut http1_requests : Int
  mut http2_requests : Int
  mut reused_http1_transfers : Int
  mut multiplexed_http2_streams : Int
  mut cancellations : Int
  mut failures : Int
  mut timeouts : Int
  mut response_bytes : Int64
  mut rss_first_kib : Int
  mut rss_last_kib : Int
  mut rss_max_kib : Int
  mut rss_samples : Int
  http1_batch_ms : Array[Double]
  http2_batch_ms : Array[Double]
  cancellation_ms : Array[Double]
}

///|
fn distribution(values : Array[Double]) -> Json {
  if values.is_empty() { return Json::null() }
  let sorted = values.copy()
  sorted.sort()
  // Nearest-rank percentiles, retaining every completed observation.
  { "count": sorted.length(), "p50_ms": sorted[(sorted.length() * 50 + 99) / 100 - 1],
    "p95_ms": sorted[(sorted.length() * 95 + 99) / 100 - 1],
    "p99_ms": sorted[(sorted.length() * 99 + 99) / 100 - 1],
    "max_ms": sorted[sorted.length() - 1] }
}

///|
fn decimal(value : StringView) -> Int raise {
  guard !value.is_empty() else { fail("empty decimal") }
  let mut result = 0
  for byte in @utf8.encode(value) {
    guard byte >= b'0' && byte <= b'9' && result <= (2147483647 - byte.to_int() + 48) / 10 else {
      fail("invalid decimal: \{value}")
    }
    result = result * 10 + byte.to_int() - 48
  }
  result
}

///|
async fn log_line(path : String, value : Json) -> Unit {
  @fs.write_file(path, value.stringify() + "\n", append=true, create_mode=OpenOrCreate)
}

///|
async fn metadata(directory : String, label : String, program : String, args : Array[String]) -> Unit {
  let (status, out, err) = @async.with_timeout(15000, async fn() { @process.collect_output(program, args) })
  @fs.write_file(directory + "/" + label + ".txt", out.binary(), create_mode=CreateNew)
  guard status == 0 else { fail("\{label}: \{err.text()}") }
}

///|
fn h2_completed_stats(text : String, count : Int) -> Bool {
  let mut completed = 0
  for line in text.split("\n") {
    let words = line.trim().split(" ").filter(fn(word) { !word.is_empty() }).to_array()
    if words.length() >= 7 && words[0].iter().all(fn(ch) { ch >= '0' && ch <= '9' }) {
      if words[4] != "200" { return false }
      completed += 1
    }
  }
  completed == count
}

///|
fn transfer_args(http1 : Bool, directory : String, batch_requests : Int) -> Array[String] {
  let url = "http://127.0.0.1:18080/echo"
  if http1 {
    let args = ["--silent", "--show-error", "--fail", "--http1.1", "--noproxy", "*",
      "--max-time", "10", "--data-binary", "@" + directory + "/payload.bin",
      "--write-out", "\nHTTP:%{http_code} bytes:%{size_download} connections:%{num_connects}\n"]
    for _ in 0..<batch_requests { args.push(url) }
    args
  } else {
    ["--stat", "--timeout=10s", "--no-dep", "--no-push", "--multiply=3",
      "--data=" + directory + "/payload.bin", "--header-table-size=0",
      "--header-table-size=4096", url].map(fn(value) {
        if value == "--multiply=3" {
          "--multiply=" + batch_requests.to_string()
        } else {
          value
        }
      })
  }
}

///|
fn repeated_payload(payload : String, count : Int) -> String {
  Array::makei(count, fn(_) { payload }).join("")
}

///|
fn verified_transfer(http1 : Bool, bytes : Bytes, payload : String, batch_requests : Int) -> Bool {
  if http1 {
    let mut expected = ""
    for index in 0..<batch_requests {
      expected += payload + "\nHTTP:200 bytes:\{payload.length()} connections:\{if index == 0 { 1 } else { 0 }}\n"
    }
    @utf8.decode_lossy(bytes) == expected
  } else {
    let expected = @utf8.encode(repeated_payload(payload, batch_requests))
    bytes.has_prefix(expected) && h2_completed_stats(@utf8.decode_lossy(bytes[expected.length():]), batch_requests)
  }
}

///|
async fn verify_reuse(directory : String, payload : String, batch_requests : Int) -> Bool {
  let mut passed = true
  for http1 in [true, false] {
    let program = if http1 { "curl" } else { "nghttp" }
    let args = transfer_args(http1, directory, batch_requests)
    let label = directory + "/post-cancel-" + program
    let command : Json = { "program": program, "arguments": args }
    @fs.write_file(label + ".command.json", command, create_mode=CreateNew)
    let result = @async.with_timeout_opt(12000, async fn() { @process.collect_output(program, args) })
    match result {
      Some((status, output, errors)) => {
        @fs.write_file(label + ".stdout", output.binary(), create_mode=CreateNew)
        @fs.write_file(label + ".stderr", errors.binary(), create_mode=CreateNew)
        let valid = status == 0 && errors.text().is_empty() &&
          verified_transfer(http1, output.binary(), payload, batch_requests)
        let result : Json = { "exit": status, "passed": valid }
        @fs.write_file(label + ".result.json", result, create_mode=CreateNew)
        if !valid { passed = false }
      }
      None => {
        let result : Json = { "passed": false, "timeout_ms": 12000 }
        @fs.write_file(label + ".result.json", result, create_mode=CreateNew)
        passed = false
      }
    }
  }
  passed
}

///|
async fn worker(
  id : Int,
  directory : String,
  payload : String,
  counters : Counters,
  protocol : String,
  batch_requests : Int,
) -> Unit {
  let http1 = if protocol == "http1" || protocol == "http1-clean" { true } else if protocol == "http2" { false } else { id % 2 == 0 }
  let program = if http1 { "curl" } else { "nghttp" }
  let args = transfer_args(http1, directory, batch_requests)
  let command : Json = { "program": program, "arguments": args }
  @fs.write_file(directory + "/worker-\{id}.command.json", command, create_mode=CreateNew)
  let log = directory + "/worker-\{id}.jsonl"
  let mut batch = 0
  while !counters.stop {
    batch += 1
    counters.attempts += 1
    let started = @bench.monotonic_clock_start()
    let result = @async.with_timeout_opt(12000, async fn() { @process.collect_output(program, args) })
    let elapsed_ms = @bench.monotonic_clock_end(started) / 1000.0
    match result {
      None => {
        counters.failures += 1
        counters.timeouts += 1
        log_line(log, { "batch": batch, "status": "tool-timeout", "timeout_ms": 12000, "elapsed_ms": elapsed_ms })
      }
      Some((status, output, errors)) => {
        let bytes = output.binary()
        let stderr = errors.text()
        let valid = status == 0 && stderr.is_empty() &&
          verified_transfer(http1, bytes, payload, batch_requests)
        if valid {
          counters.response_bytes += (payload.length() * batch_requests).to_int64()
          if http1 {
            counters.http1_requests += batch_requests
            counters.reused_http1_transfers += batch_requests - 1
            counters.http1_batch_ms.push(elapsed_ms)
          } else {
            counters.http2_requests += batch_requests
            counters.multiplexed_http2_streams += batch_requests
            counters.http2_batch_ms.push(elapsed_ms)
          }
        } else {
          counters.failures += 1
          @fs.write_file(directory + "/worker-\{id}-failure-\{batch}.stdout", bytes, create_mode=CreateNew)
          @fs.write_file(directory + "/worker-\{id}-failure-\{batch}.stderr", stderr, create_mode=CreateNew)
        }
        log_line(log, {
          "batch": batch, "exit": status, "passed": valid,
          "elapsed_ms": elapsed_ms,
          "verified_requests": if valid { batch_requests } else { 0 },
          "verified_response_bytes": if valid { payload.length() * batch_requests } else { 0 },
          "stdout_bytes": bytes.length(),
          "stdout_sha256": @crypto.bytes_to_hex_string(@crypto.sha256(bytes)),
        })
      }
    }
    if counters.failures >= 10 { counters.stop = true }
  }
}

///|
async fn cancellation_worker(directory : String, counters : Counters) -> Unit {
  let args = ["--silent", "--show-error", "--http1.1", "--noproxy", "*",
    "--limit-rate", "1024", "--max-time", "0.05", "--output", "/dev/null",
    "--data-binary", "@" + directory + "/payload.bin", "http://127.0.0.1:18080/cancel"]
  let command : Json = { "program": "curl", "arguments": args }
  @fs.write_file(directory + "/cancellation.command.json", command, create_mode=CreateNew)
  while !counters.stop {
    // This explicit 50ms curl deadline deliberately cancels a slow upload.
    // The separate process timeout is unexpected and always counted as failure.
    let started = @bench.monotonic_clock_start()
    let result = @async.with_timeout_opt(5000, async fn() { @process.collect_output("curl", args) })
    let elapsed_ms = @bench.monotonic_clock_end(started) / 1000.0
    match result {
      Some((28, _, error)) => {
        counters.cancellations += 1
        counters.cancellation_ms.push(elapsed_ms)
        log_line(directory + "/cancellations.jsonl", { "expected_curl_timeout_exit": 28, "process_elapsed_ms": elapsed_ms, "stderr": error.text() })
      }
      Some((status, _, error)) => {
        counters.failures += 1
        log_line(directory + "/cancellations.jsonl", { "unexpected_exit": status, "process_elapsed_ms": elapsed_ms, "stderr": error.text() })
      }
      None => {
        counters.failures += 1
        counters.timeouts += 1
        log_line(directory + "/cancellations.jsonl", { "status": "unexpected-process-timeout", "timeout_ms": 5000, "process_elapsed_ms": elapsed_ms })
      }
    }
    if counters.failures >= 10 { counters.stop = true }
    @async.sleep(25)
  }
}

///|
async fn main {
  let args = @env.args()
  let mut duration_seconds = 300
  let mut concurrency = 6
  let mut payload_bytes = 65536
  let mut batch_requests = 3
  let mut server_path = "_build/native/debug/build/examples/cmd/smoke_server/smoke_server.exe"
  let mut protocol = "mixed"
  let mut evidence_path : String? = None
  guard args.length() % 2 == 1 else { fail("options require values") }
  for index in 0..<((args.length() - 1) / 2) {
    let i = 1 + index * 2
    match args[i] {
      "--duration-seconds" => duration_seconds = decimal(args[i + 1])
      "--concurrency" => concurrency = decimal(args[i + 1])
      "--payload-bytes" => payload_bytes = decimal(args[i + 1])
      "--batch-requests" => batch_requests = decimal(args[i + 1])
      "--server" => server_path = args[i + 1]
      "--protocol" => protocol = args[i + 1]
      "--evidence" => evidence_path = Some(args[i + 1])
      _ => fail("unknown stress option: \{args[i]}")
    }
  }
  guard duration_seconds >= 1 && duration_seconds <= 3600 && concurrency >= 2 &&
    concurrency <= 32 && payload_bytes >= 4096 && payload_bytes <= 1048576 else {
    fail("limits: duration 1..3600s, concurrency 2..32, body 4096..1048576 bytes")
  }
  guard protocol == "mixed" || protocol == "http1" || protocol == "http1-clean" ||
    protocol == "http2" || protocol == "cancel" else {
    fail("protocol must be mixed, http1, http1-clean, http2 or cancel")
  }
  guard batch_requests >= 1 && batch_requests <= 32 else {
    fail("batch requests must be 1..32")
  }
  let directory = match evidence_path {
    Some(path) => {
      guard !@fs.exists(path) else { fail("evidence path already exists: \{path}") }
      path
    }
    None => {
      let temporary = @fs.tmpdir(prefix="moonbithttp-stress")
      let unique = temporary.split("/").to_array().last().unwrap().to_owned()
      @fs.rmdir(temporary)
      "_build/evidence/stress/" + unique
    }
  }
  @fs.mkdir(directory, recursive=true)
  println("Stress evidence: \{directory}")
  for program in ["curl", "nghttp"] { metadata(directory, program + "-version", program, ["--version"]) }
  // The controlled comparison records toolchain metadata before measurement.
  // Standalone runs retain their previous self-contained metadata contract.
  if evidence_path is None { metadata(directory, "toolchain", "moon", ["version", "--all"]) }
  metadata(directory, "system", "uname", ["-a"])
  metadata(directory, "revision", "git", ["rev-parse", "HEAD"])
  metadata(directory, "worktree", "git", ["status", "--porcelain=v1", "--untracked-files=all"])
  let server_sha256 = @crypto.bytes_to_hex_string(@crypto.sha256(@fs.read_file(server_path).binary()))
  let payload = String::make(payload_bytes, 'x')
  @fs.write_file(directory + "/payload.bin", payload, create_mode=CreateNew)
  let counters : Counters = { stop: false, attempts: 0, http1_requests: 0, http2_requests: 0,
    reused_http1_transfers: 0, multiplexed_http2_streams: 0, cancellations: 0,
    failures: 0, timeouts: 0, response_bytes: 0L, rss_first_kib: 0, rss_last_kib: 0, rss_max_kib: 0,
    rss_samples: 0, http1_batch_ms: [], http2_batch_ms: [], cancellation_ms: [] }
  let address = @socket.Addr::parse("127.0.0.1:18080")
  let reservation = @socket.TcpServer(address, reuse_addr=false)
  reservation.close()
  let mut started = @bench.monotonic_clock_start()
  let mut completed_duration = false
  let mut elapsed_ms = 0.0
  let mut post_cancel_reuse = false
  @async.with_task_group(async fn(server_group) {
    let out = @process.redirect_to_file(directory + "/server.stdout", create_mode=CreateNew)
    let err = @process.redirect_to_file(directory + "/server.stderr", create_mode=CreateNew)
    let executable = if server_path.has_prefix("/") { server_path } else { "./" + server_path }
    let server = @process.spawn(server_group, executable, [], stdout=out, stderr=err,
      cancel_handler=@process.graceful_cancel(timeout=1000), no_wait=true)
    defer server.cancel()
    @async.with_timeout(10000, async fn() {
      while true {
        guard server.try_wait() is None else { fail("server exited during readiness") }
        let connection : Result[@socket.Tcp, Error] = Ok(@socket.Tcp::connect(address)) catch { error => Err(error) }
        match connection {
          Ok(socket) => { socket.close(); break }
          Err(_) => @async.sleep(50)
        }
      }
    })
    // Warm up both protocol paths before starting the measured admission window.
    guard verify_reuse(directory, payload, batch_requests) else { fail("protocol warmup oracle failed") }
    started = @bench.monotonic_clock_start()
    @async.with_task_group(async fn(group) {
      group.spawn_bg(async fn() {
        @async.sleep(duration_seconds * 1000)
        completed_duration = true
        counters.stop = true
      }, no_wait=true)
      if protocol != "cancel" {
        for id in 0..<concurrency {
          group.spawn_bg(async fn() { worker(id, directory, payload, counters, protocol, batch_requests) })
        }
      }
      if protocol == "mixed" || protocol == "http1" || protocol == "cancel" {
        group.spawn_bg(async fn() { cancellation_worker(directory, counters) })
      }
      while !counters.stop {
        guard server.try_wait() is None else { fail("server exited during stress") }
        let (status, output, errors) = @async.with_timeout(5000, async fn() {
          @process.collect_output("ps", ["-o", "rss=", "-p", server.pid.to_string()])
        })
        guard status == 0 else { fail("RSS sample failed: \{errors.text()}") }
        let rss = decimal(output.text().trim())
        if counters.rss_first_kib == 0 { counters.rss_first_kib = rss }
        counters.rss_last_kib = rss
        counters.rss_max_kib = counters.rss_max_kib.max(rss)
        counters.rss_samples += 1
        log_line(directory + "/rss.jsonl", { "elapsed_ms": @bench.monotonic_clock_end(started) / 1000.0, "rss_kib": rss })
        @async.sleep(250)
      }
    })
    guard server.try_wait() is None else { fail("server exited before stress completed") }
    // Include completion of admitted batches, but exclude reuse probes/shutdown.
    elapsed_ms = @bench.monotonic_clock_end(started) / 1000.0
    let recovery = directory + "/recovery"
    @fs.mkdir(recovery)
    @fs.write_file(recovery + "/payload.bin", payload, create_mode=CreateNew)
    post_cancel_reuse = verify_reuse(recovery, payload, batch_requests)
    server.cancel()
    let stopped : Result[Int, Error] = Ok(server.wait()) catch { error => Err(error) }
    ignore(stopped)
  })
  let protocol_requests_passed = if protocol == "http1" || protocol == "http1-clean" {
    counters.http1_requests > 0
  } else if protocol == "http2" {
    counters.http2_requests > 0
  } else if protocol == "cancel" {
    counters.cancellations > 0
  } else {
    counters.http1_requests > 0 && counters.http2_requests > 0
  }
  let cancellation_passed = protocol == "http2" || protocol == "http1-clean" || counters.cancellations > 0
  let passed = completed_duration && counters.failures == 0 && protocol_requests_passed &&
    cancellation_passed && post_cancel_reuse && counters.rss_samples > 0
  let result : Json = {
    "passed": passed, "scope": "bounded local HTTP1/HTTP2 stress; production long-run gate open",
    "protocol": protocol,
    "requests_per_batch": batch_requests,
    "requested_duration_seconds": duration_seconds, "elapsed_ms": elapsed_ms,
    "timing_scope": "admission window plus admitted-batch drain; excludes warmup, recovery probes and server shutdown",
    "batch_latency_scope": "client process startup, three verified requests, output collection; not single-request or network latency",
    "cancellation_latency_scope": "curl process start through expected 50ms deadline exit; not server task reclamation latency",
    "http1_batch_latency": distribution(counters.http1_batch_ms), "http2_batch_latency": distribution(counters.http2_batch_ms),
    "cancellation_process_latency": distribution(counters.cancellation_ms),
    "http1_requests_per_second": counters.http1_requests.to_double() * 1000.0 / elapsed_ms,
    "http2_requests_per_second": counters.http2_requests.to_double() * 1000.0 / elapsed_ms,
    "http1_verified_bytes_per_second": counters.http1_requests.to_double() * payload_bytes.to_double() * 1000.0 / elapsed_ms,
    "http2_verified_bytes_per_second": counters.http2_requests.to_double() * payload_bytes.to_double() * 1000.0 / elapsed_ms,
    "post_cancel_reuse_passed": post_cancel_reuse,
    "concurrency": concurrency, "additional_cancellation_worker": 1, "payload_bytes": payload_bytes,
    "batch_attempts": counters.attempts, "http1_requests": counters.http1_requests,
    "http2_requests": counters.http2_requests, "reused_http1_transfers": counters.reused_http1_transfers,
    "multiplexed_http2_streams": counters.multiplexed_http2_streams,
    "deliberate_upload_cancellations": counters.cancellations, "failures": counters.failures,
    "unexpected_process_timeouts": counters.timeouts, "response_body_bytes_verified": counters.response_bytes,
    "rss_first_kib": counters.rss_first_kib, "rss_last_kib": counters.rss_last_kib, "rss_max_kib": counters.rss_max_kib,
    "rss_samples": counters.rss_samples, "rss_growth_kib": counters.rss_max_kib - counters.rss_first_kib,
    "server_sha256": server_sha256, "server_cleanup": "cancelled and reaped",
  }
  @fs.write_file(directory + "/result.json", result, create_mode=CreateNew)
  println(result.stringify())
  guard passed else { fail("stress window failed; raw evidence: \{directory}") }
}
