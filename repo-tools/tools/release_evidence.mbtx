----
import {
  "moonbitlang/async@0.22.10",
  "moonbitlang/async@0.22.10/process",
  "moonbitlang/core/env",
}
----

///|
async fn main {
  let args = @env.args()
  let option = if args.length() == 1 {
    "--release-evidence"
  } else if args.length() == 2 && args[1] == "--check-clean" {
    "--check-clean"
  } else {
    fail("usage: release_evidence.mbtx [--check-clean]")
  }
  let status = @process.run("moon", [
    "run", "repo-tools/tools/check_distribution.mbtx", option,
  ])
  guard status == 0 else {
    fail("distribution verification failed with exit \{status}")
  }
  if option == "--release-evidence" {
    let consumer_status = @process.run("moon", ["run","repo-tools/tools/verify_consumers.mbtx"])
    guard consumer_status == 0 else { fail("external consumer verification failed with exit \{consumer_status}") }
  }
}
