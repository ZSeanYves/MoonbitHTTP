----
import {
  "moonbitlang/async@0.22.10",
  "moonbitlang/async@0.22.10/fs",
  "moonbitlang/async@0.22.10/process",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
}
----

///|
async fn command(
  program : String,
  arguments : Array[String],
  timeout_ms? : Int = 60000,
) -> Bytes {
  let (status, output, errors) = @async.with_timeout(timeout_ms, async fn() {
    @process.collect_output(program, arguments)
  })
  guard status == 0 else {
    fail(
      "\{program} \{arguments.join(" ")}: exit \{status}; \{output.text()}\n\{errors.text()}",
    )
  }
  output.binary()
}

///|
async fn command_text(program : String, arguments : Array[String]) -> String {
  @utf8.decode(command(program, arguments))
}

///|
fn manifest_strings(manifest : Json, field : String) -> Array[String] raise {
  guard manifest is Object(fields) && fields.get(field) is Some(Array(values)) else {
    fail("distribution manifest requires an array for \{field}")
  }
  let result : Array[String] = []
  for value in values {
    guard value is String(path) && !path.is_empty() else {
      fail("distribution manifest \{field} contains a non-string path")
    }
    result.push(path)
  }
  result
}

///|
fn matches(path : String, pattern : String) -> Bool {
  if pattern.has_suffix("/**") {
    let prefix = pattern[:pattern.length() - 3]
    path.has_prefix(prefix + "/")
  } else {
    path == pattern
  }
}

///|
fn included(
  path : String,
  includes : Array[String],
  excludes : Array[String],
) -> Bool {
  includes.any(fn(pattern) { matches(path, pattern) }) &&
  !excludes.any(fn(pattern) { matches(path, pattern) })
}

///|
fn safe_member(path : String) -> Bool {
  !path.is_empty() &&
  !path.has_prefix("/") &&
  !path.has_prefix("-") &&
  !path.contains("\\") &&
  !path.contains(":") &&
  !path
  .split("/")
  .any(fn(part) {
    part == "" ||
    part == "." ||
    part == ".." ||
    part == ".git" ||
    part == "_build" ||
    part == "target" ||
    part == ".mooncakes" ||
    part == "coverage" ||
    part == "evidence"
  }) &&
  !path.has_suffix(".zip") &&
  !path.has_suffix(".coverage") &&
  !path.has_suffix(".profraw") &&
  path != "coverage.xml" &&
  path != "coverage.json"
}

///|
async fn require_clean() -> Unit {
  let changes = command("git", [
    "status", "--porcelain=v1", "-z", "--untracked-files=all",
  ])
  guard changes.is_empty() else {
    fail(
      "release gate closed: tracked edits or untracked files exist; freeze and commit reviewed source before checking the distribution",
    )
  }
}

///|
fn digest(bytes : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
}

///|
async fn main {
  let args = @env.args()
  let evidence_requested = args.length() == 2 && args[1] == "--release-evidence"
  let clean_only = args.length() == 2 && args[1] == "--check-clean"
  guard args.length() == 1 || evidence_requested || clean_only else {
    fail("usage: check_distribution.mbtx [--release-evidence | --check-clean]")
  }
  require_clean()
  if clean_only {
    println("PASS: worktree is clean; no package created.")
    return
  }
  let revision = command_text("git", ["rev-parse", "HEAD"]).trim().to_owned()
  let distribution_manifest = @fs.read_file(
    "repo-tools/tools/distribution.json",
  ).text()
  let manifest = @json.parse(distribution_manifest)
  guard manifest
    is {
      "schema_version": Number(schema, ..),
      "module": String(name),
      "version": String(version),
      ..
    } &&
    schema == 1.0 else {
    fail("invalid distribution manifest header")
  }
  let includes = manifest_strings(manifest, "include")
  let excludes = manifest_strings(manifest, "exclude")
  let required = manifest_strings(manifest, "required")
  let source = @fs.read_file("moon.mod").text()
  guard source.contains("name = \"\{name}\"") &&
    source.contains("version = \"\{version}\"") else {
    fail("distribution manifest module/version differs from moon.mod")
  }
  let expected : Set[String] = Set([])
  for
    entry in command_text("git", [
      "ls-tree", "-r", "-z", "--name-only", revision,
    ]).split("\u{0}") {
    let path = entry.to_owned()
    if !path.is_empty() && included(path, includes, excludes) {
      expected.add(path)
    }
  }
  for path in required {
    guard expected.contains(path) else {
      fail("required distribution member is missing: \{path}")
    }
  }
  for pattern in includes {
    guard expected.iter().any(path => matches(path, pattern)) else {
      fail("empty distribution include: \{pattern}")
    }
  }
  ignore(command("moon", ["package", "--frozen"]))
  let archive = "_build/publish/" +
    name.replace(old="/", new="-") +
    "-" +
    version +
    ".zip"
  let bytes = @fs.read_file(archive).binary()
  // All following checks read this snapshot, even if another package build starts.
  let temporary = @fs.tmpdir(prefix="moonbithttp-distribution")
  let snapshot = temporary + "/package.zip"
  let extracted = temporary + "/extracted"
  @fs.write_file(snapshot, bytes, create_mode=CreateNew)
  let actual : Set[String] = Set([])
  let paths : Array[String] = []
  for entry in command_text("unzip", ["-Z1", snapshot]).split("\n") {
    if entry.is_empty() {
      continue
    }
    if entry.strip_suffix("/") is Some(directory) {
      guard safe_member(directory.to_owned()) else {
        fail("unsafe archive directory: \{entry}")
      }
      continue
    }
    let path = entry.to_owned()
    guard safe_member(path) && expected.contains(path) else {
      fail("unexpected archive member: \{path}")
    }
    guard !actual.contains(path) else {
      fail("duplicate archive member: \{path}")
    }
    actual.add(path)
    paths.push(path)
  }
  for path in expected {
    guard actual.contains(path) else {
      fail("frozen source is missing from archive: \{path}")
    }
  }
  paths.sort()
  guard !paths.is_empty() else { fail("empty distribution") }
  println("Checking extracted package in \{extracted}")
  ignore(command("unzip", ["-q", snapshot, "-d", extracted]))
  let files : Array[Json] = []
  let mut unpacked_bytes = 0
  for path in paths {
    let packaged = @fs.read_file(extracted + "/" + path).binary()
    let committed = command("git", ["show", revision + ":" + path])
    guard packaged == committed else {
      fail("archive differs from frozen Git source: \{path}")
    }
    if evidence_requested {
      unpacked_bytes += packaged.length()
      files.push({
        "path": path,
        "bytes": packaged.length(),
        "sha256": digest(packaged),
      })
    }
  }
  ignore(
    command(
      "moon",
      [
        "-C", extracted, "check", "--target", "all", "--deny-warn", "--warn-list",
        "+73",
      ],
      timeout_ms=300000,
    ),
  )
  let snapshot_metadata = if evidence_requested {
    let toolchain = command_text("moon", ["version", "--all"])
    let dependencies = command_text("moon", ["tree", "--json"])
    ignore(@json.parse(dependencies))
    Some((toolchain, dependencies))
  } else {
    None
  }
  require_clean()
  guard command_text("git", ["rev-parse", "HEAD"]).trim() == revision &&
    @fs.read_file(archive).binary() == bytes else {
    fail("revision or archive changed during packaging")
  }
  @fs.rmdir(temporary, recursive=true)
  println(
    "PASS: verified \{paths.length()} files and extracted four-target check for \{name}@\{version}.",
  )
  guard snapshot_metadata is Some((toolchain, dependencies)) else { return }
  let listed = paths.join("\n") + "\n"
  let directory = "_build/evidence/release/" + revision
  @fs.mkdir(directory, recursive=true)
  @fs.write_file(
    directory + "/package-list.txt",
    listed,
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    directory + "/toolchain.txt",
    toolchain,
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(directory + "/moon.mod", source, create_mode=CreateOrTruncate)
  @fs.write_file(
    directory + "/resolved-dependencies.json",
    dependencies,
    create_mode=CreateOrTruncate,
  )
  let evidence : Json = {
    "status": "frozen-package-verified",
    "production_release_approved": false,
    "git_revision": revision,
    "module": name,
    "version": version,
    "archive": archive,
    "sha256": digest(bytes),
    "compressed_bytes": bytes.length(),
    "unpacked_bytes": unpacked_bytes,
    "file_count": files.length(),
    "files": files,
    "dependency_snapshot": "resolved-dependencies.json",
    "dependency_lock": "moon has no committed lockfile here; pinned moon.mod plus resolved dependency snapshot are evidence, not a resolver lock",
    "distribution_manifest_sha256": digest(@utf8.encode(distribution_manifest)),
    "release_gate_assessment": "not assessed by packaging tool; consult docs/release/roadmap.zh-CN.md",
  }
  @fs.write_file(
    directory + "/evidence.json",
    evidence,
    create_mode=CreateOrTruncate,
  )
  println(
    "Frozen package verified: \{archive}\nSHA-256: \{digest(bytes)}\nEvidence: \{directory}\nProduction release gates remain separate; nothing was published.",
  )
}
