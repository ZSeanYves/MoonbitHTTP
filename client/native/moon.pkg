  "ZSeanYves/MoonbitHTTP/client",
  "ZSeanYves/MoonbitHTTP/content_coding",
  "ZSeanYves/MoonbitHTTP/transport",
  "ZSeanYves/MoonbitHTTP/transport/native" @transport_native,
}

