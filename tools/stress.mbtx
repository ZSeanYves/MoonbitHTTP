import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
  "moonbitlang/async@0.20.2/process",
  "moonbitlang/async@0.20.2/socket",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.4.47/crypto",
}

///|
struct Counters {
  mut stop : Bool
  mut attempts : Int
  mut http1_requests : Int
  mut http2_requests : Int
  mut reused_http1_transfers : Int
  mut multiplexed_http2_streams : Int
  mut cancellations : Int
  mut failures : Int
  mut timeouts : Int
  mut response_bytes : Int64
  mut rss_first_kib : Int
  mut rss_last_kib : Int
  mut rss_max_kib : Int
}

///|
fn decimal(value : StringView) -> Int raise {
  guard !value.is_empty() else { fail("empty decimal") }
  let mut result = 0
  for byte in @utf8.encode(value) {
    guard byte >= b'0' && byte <= b'9' && result <= (2147483647 - byte.to_int() + 48) / 10 else {
      fail("invalid decimal: \{value}")
    }
    result = result * 10 + byte.to_int() - 48
  }
  result
}

///|
async fn log_line(path : String, value : Json) -> Unit {
  @fs.write_file(path, value.stringify() + "\n", append=true, create_mode=OpenOrCreate)
}

///|
async fn metadata(directory : String, label : String, program : String, args : Array[String]) -> Unit {
  let (status, out, err) = @async.with_timeout(15000, async fn() { @process.collect_output(program, args) })
  @fs.write_file(directory + "/" + label + ".txt", out.binary(), create_mode=CreateNew)
  guard status == 0 else { fail("\{label}: \{err.text()}") }
}

///|
fn h2_completed_stats(text : String, count : Int) -> Bool {
  let mut completed = 0
  for line in text.split("\n") {
    let words = line.trim().split(" ").filter(fn(word) { !word.is_empty() }).to_array()
    if words.length() >= 7 && words[0].iter().all(fn(ch) { ch >= '0' && ch <= '9' }) {
      if words[4] != "200" { return false }
      completed += 1
    }
  }
  completed == count
}

///|
async fn worker(
  id : Int,
  directory : String,
  payload : String,
  counters : Counters,
) -> Unit {
  let http1 = id % 2 == 0
  let program = if http1 { "curl" } else { "nghttp" }
  let url = "http://127.0.0.1:18080/echo"
  let args = if http1 {
    ["--silent", "--show-error", "--fail", "--http1.1", "--noproxy", "*",
      "--max-time", "10", "--data-binary", "@" + directory + "/payload.bin",
      "--write-out", "\nHTTP:%{http_code} bytes:%{size_download} connections:%{num_connects}\n",
      url, url, url]
  } else {
    ["--stat", "--timeout=10s", "--no-dep", "--no-push", "--multiply=3",
      "--data=" + directory + "/payload.bin", "--header-table-size=0",
      "--header-table-size=4096", url]
  }
  @fs.write_file(directory + "/worker-\{id}.command.txt", program + " " + args.join(" ") + "\n", create_mode=CreateNew)
  let expected_body = @utf8.encode(payload + payload + payload)
  let expected_http1 = payload + "\nHTTP:200 bytes:\{payload.length()} connections:1\n" +
    payload + "\nHTTP:200 bytes:\{payload.length()} connections:0\n" +
    payload + "\nHTTP:200 bytes:\{payload.length()} connections:0\n"
  let log = directory + "/worker-\{id}.jsonl"
  let mut batch = 0
  while !counters.stop {
    batch += 1
    counters.attempts += 1
    let started = @env.now()
    let result = @async.with_timeout_opt(12000, async fn() { @process.collect_output(program, args) })
    match result {
      None => {
        counters.failures += 1
        counters.timeouts += 1
        log_line(log, { "batch": batch, "status": "tool-timeout", "timeout_ms": 12000 })
      }
      Some((status, output, errors)) => {
        let bytes = output.binary()
        let stderr = errors.text()
        let valid = status == 0 && stderr.is_empty() && (if http1 {
          output.text() == expected_http1
        } else {
          bytes.has_prefix(expected_body) &&
            h2_completed_stats(@utf8.decode(bytes[expected_body.length():]), 3)
        })
        if valid {
          counters.response_bytes += expected_body.length().to_int64()
          if http1 {
            counters.http1_requests += 3
            counters.reused_http1_transfers += 2
          } else {
            counters.http2_requests += 3
            counters.multiplexed_http2_streams += 3
          }
        } else {
          counters.failures += 1
          @fs.write_file(directory + "/worker-\{id}-failure-\{batch}.stdout", bytes, create_mode=CreateNew)
          @fs.write_file(directory + "/worker-\{id}-failure-\{batch}.stderr", stderr, create_mode=CreateNew)
        }
        log_line(log, {
          "batch": batch, "exit": status, "passed": valid,
          "elapsed_ms": (@env.now() - started).reinterpret_as_int64(),
          "stdout_bytes": bytes.length(),
          "stdout_sha256": @crypto.bytes_to_hex_string(@crypto.sha256(bytes)),
        })
      }
    }
    if counters.failures >= 10 { counters.stop = true }
  }
}

///|
async fn cancellation_worker(directory : String, counters : Counters) -> Unit {
  let args = ["--silent", "--show-error", "--http1.1", "--noproxy", "*",
    "--limit-rate", "1024", "--max-time", "0.05", "--output", "/dev/null",
    "--data-binary", "@" + directory + "/payload.bin", "http://127.0.0.1:18080/cancel"]
  @fs.write_file(directory + "/cancellation.command.txt", "curl " + args.join(" ") + "\n", create_mode=CreateNew)
  while !counters.stop {
    // This explicit 50ms curl deadline deliberately cancels a slow upload.
    // The separate process timeout is unexpected and always counted as failure.
    let result = @async.with_timeout_opt(5000, async fn() { @process.collect_output("curl", args) })
    match result {
      Some((28, _, error)) => {
        counters.cancellations += 1
        log_line(directory + "/cancellations.jsonl", { "expected_curl_timeout_exit": 28, "stderr": error.text() })
      }
      Some((status, _, error)) => {
        counters.failures += 1
        log_line(directory + "/cancellations.jsonl", { "unexpected_exit": status, "stderr": error.text() })
      }
      None => {
        counters.failures += 1
        counters.timeouts += 1
        log_line(directory + "/cancellations.jsonl", { "status": "unexpected-process-timeout", "timeout_ms": 5000 })
      }
    }
    if counters.failures >= 10 { counters.stop = true }
    @async.sleep(100)
  }
}

///|
async fn main {
  let args = @env.args()
  let mut duration_seconds = 300
  let mut concurrency = 6
  let mut payload_bytes = 65536
  let mut server_path = "_build/native/debug/build/cmd/smoke_server/smoke_server.exe"
  guard args.length() % 2 == 1 else { fail("options require values") }
  for index in 0..<((args.length() - 1) / 2) {
    let i = 1 + index * 2
    match args[i] {
      "--duration-seconds" => duration_seconds = decimal(args[i + 1])
      "--concurrency" => concurrency = decimal(args[i + 1])
      "--payload-bytes" => payload_bytes = decimal(args[i + 1])
      "--server" => server_path = args[i + 1]
      _ => fail("unknown stress option: \{args[i]}")
    }
  }
  guard duration_seconds >= 1 && duration_seconds <= 3600 && concurrency >= 2 &&
    concurrency <= 32 && payload_bytes >= 4096 && payload_bytes <= 1048576 else {
    fail("limits: duration 1..3600s, concurrency 2..32, body 4096..1048576 bytes")
  }
  let temporary = @fs.tmpdir(prefix="moonbithttp-stress")
  let unique = temporary.split("/").to_array().last().unwrap().to_owned()
  @fs.rmdir(temporary)
  let directory = "_build/evidence/stress/" + unique
  @fs.mkdir(directory, recursive=true)
  println("Stress evidence: \{directory}")
  for program in ["curl", "nghttp"] { metadata(directory, program + "-version", program, ["--version"]) }
  metadata(directory, "toolchain", "moon", ["version", "--all"])
  metadata(directory, "system", "uname", ["-a"])
  metadata(directory, "revision", "git", ["rev-parse", "HEAD"])
  metadata(directory, "worktree", "git", ["status", "--porcelain=v1", "--untracked-files=all"])
  let server_sha256 = @crypto.bytes_to_hex_string(@crypto.sha256(@fs.read_file(server_path).binary()))
  let payload = String::make(payload_bytes, 'x')
  @fs.write_file(directory + "/payload.bin", payload, create_mode=CreateNew)
  let counters : Counters = { stop: false, attempts: 0, http1_requests: 0, http2_requests: 0,
    reused_http1_transfers: 0, multiplexed_http2_streams: 0, cancellations: 0,
    failures: 0, timeouts: 0, response_bytes: 0L, rss_first_kib: 0, rss_last_kib: 0, rss_max_kib: 0 }
  let address = @socket.Addr::parse("127.0.0.1:18080")
  let reservation = @socket.TcpServer(address, reuse_addr=false)
  reservation.close()
  let mut started = @env.now()
  let mut completed_duration = false
  @async.with_task_group(async fn(server_group) {
    let out = @process.redirect_to_file(directory + "/server.stdout", create_mode=CreateNew)
    let err = @process.redirect_to_file(directory + "/server.stderr", create_mode=CreateNew)
    let executable = if server_path.has_prefix("/") { server_path } else { "./" + server_path }
    let server = @process.spawn(server_group, executable, [], stdout=out, stderr=err,
      cancel_handler=@process.graceful_cancel(timeout=1000), no_wait=true)
    defer server.cancel()
    @async.with_timeout(10000, async fn() {
      while true {
        guard server.try_wait() is None else { fail("server exited during readiness") }
        let connection : Result[@socket.Tcp, Error] = Ok(@socket.Tcp::connect(address)) catch { error => Err(error) }
        match connection {
          Ok(socket) => { socket.close(); break }
          Err(_) => @async.sleep(50)
        }
      }
    })
    started = @env.now()
    @async.with_task_group(async fn(group) {
      group.spawn_bg(async fn() {
        @async.sleep(duration_seconds * 1000)
        completed_duration = true
        counters.stop = true
      }, no_wait=true)
      for id in 0..<concurrency { group.spawn_bg(async fn() { worker(id, directory, payload, counters) }) }
      group.spawn_bg(async fn() { cancellation_worker(directory, counters) })
      while !counters.stop {
        guard server.try_wait() is None else { fail("server exited during stress") }
        let (status, output, errors) = @async.with_timeout(5000, async fn() {
          @process.collect_output("ps", ["-o", "rss=", "-p", server.pid.to_string()])
        })
        guard status == 0 else { fail("RSS sample failed: \{errors.text()}") }
        let rss = decimal(output.text().trim())
        if counters.rss_first_kib == 0 { counters.rss_first_kib = rss }
        counters.rss_last_kib = rss
        counters.rss_max_kib = counters.rss_max_kib.max(rss)
        log_line(directory + "/rss.jsonl", { "elapsed_ms": (@env.now() - started).reinterpret_as_int64(), "rss_kib": rss })
        @async.sleep(1000)
      }
    })
    guard server.try_wait() is None else { fail("server exited before stress completed") }
    server.cancel()
    let stopped : Result[Int, Error] = Ok(server.wait()) catch { error => Err(error) }
    ignore(stopped)
  })
  let elapsed_ms = (@env.now() - started).reinterpret_as_int64()
  let passed = completed_duration && counters.failures == 0 && counters.http1_requests > 0 &&
    counters.http2_requests > 0 && counters.cancellations > 0
  let result : Json = {
    "passed": passed, "scope": "bounded local HTTP1/HTTP2 stress; production long-run gate open",
    "requested_duration_seconds": duration_seconds, "elapsed_ms": elapsed_ms,
    "concurrency": concurrency, "additional_cancellation_worker": 1, "payload_bytes": payload_bytes,
    "batch_attempts": counters.attempts, "http1_requests": counters.http1_requests,
    "http2_requests": counters.http2_requests, "reused_http1_transfers": counters.reused_http1_transfers,
    "multiplexed_http2_streams": counters.multiplexed_http2_streams,
    "deliberate_upload_cancellations": counters.cancellations, "failures": counters.failures,
    "unexpected_process_timeouts": counters.timeouts, "response_body_bytes_verified": counters.response_bytes,
    "rss_first_kib": counters.rss_first_kib, "rss_last_kib": counters.rss_last_kib, "rss_max_kib": counters.rss_max_kib,
    "server_sha256": server_sha256, "server_cleanup": "cancelled and reaped",
  }
  @fs.write_file(directory + "/result.json", result, create_mode=CreateNew)
  println(result.stringify())
  guard passed else { fail("stress window failed; raw evidence: \{directory}") }
}
