import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbit-community/idna",
}

///|
fn psl_trim_cr(value : String) -> String {
  if value.has_suffix("\r") {
    value[:value.length() - 1].to_owned()
  } else {
    value
  }
}

///|
fn psl_ascii_rule(value : String) -> String raise {
  @idna.to_ascii(
    value,
    use_std3_ascii_rules=true,
    check_hyphens=true,
    check_bidi=true,
    check_joiners=true,
    verify_dns_length=false,
  ) catch {
    error => fail("invalid IDNA rule in public suffix list: \{error}")
  }
}

///|
fn psl_write_array(
  output : StringBuilder,
  name : String,
  values : Array[String],
) -> Unit {
  values.sort()
  output.write_string("let \{name} : Array[String] = [\n")
  let mut previous : String? = None
  for value in values {
    if previous == Some(value) {
      continue
    }
    output.write_string("  \"")
    output.write_string(value)
    output.write_string("\",\n")
    previous = Some(value)
  }
  output.write_string("]\n")
}

///|
async fn main {
  let arguments = @env.args()
  guard arguments.length() == 3 else {
    fail("usage: moon run tools/generate_psl.mbtx -- INPUT OUTPUT")
  }
  let source = @fs.read_file(arguments[1]).text()
  guard source.contains("// ===BEGIN ICANN DOMAINS===") &&
    source.contains("// ===END PRIVATE DOMAINS===") else {
    fail("input is not an official publicsuffix.org list")
  }
  let exact : Array[String] = []
  let wildcard : Array[String] = []
  let exception : Array[String] = []
  let mut version = "unknown"
  let mut commit = "unknown"
  for raw_line in source.split("\n") {
    let line = psl_trim_cr(raw_line.to_owned())
    if line.has_prefix("// VERSION: ") {
      version = line[12:].to_owned()
      continue
    }
    if line.has_prefix("// COMMIT: ") {
      commit = line[11:].to_owned()
      continue
    }
    if line.is_empty() || line.has_prefix("//") {
      continue
    }
    if line.has_prefix("!" ) {
      exception.push(psl_ascii_rule(line[1:].to_owned()))
    } else if line.has_prefix("*.") {
      wildcard.push(psl_ascii_rule(line[2:].to_owned()))
    } else {
      exact.push(psl_ascii_rule(line))
    }
  }
  guard exact.length() >= 9000 && wildcard.length() >= 100 &&
    exception.length() >= 1 else {
    fail("public suffix list is unexpectedly incomplete")
  }
  let output = StringBuilder()
  output.write_string(
    "// Code generated by tools/generate_psl.mbtx; DO NOT EDIT.\n" +
    "// Source: https://publicsuffix.org/list/public_suffix_list.dat\n" +
    "// Source version: \{version}\n" +
    "// Source commit: \{commit}\n" +
    "// Data in this file is licensed under MPL-2.0.\n\n",
  )
  psl_write_array(output, "psl_exact_rules", exact)
  output.write_string("\n///|\n")
  psl_write_array(output, "psl_wildcard_rules", wildcard)
  output.write_string("\n///|\n")
  psl_write_array(output, "psl_exception_rules", exception)
  @fs.write_file(arguments[2], output.to_string())
  println(
    "generated \{exact.length()} exact, \{wildcard.length()} wildcard, " +
    "\{exception.length()} exception rules from \{version}",
  )
}
