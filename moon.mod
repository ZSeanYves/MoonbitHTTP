name = "ZSeanYves/MoonbitHTTP"

version = "0.6.0"

import {
  "moonbitlang/x@0.4.47",
  "moonbitlang/async@0.20.2",
  "mizchi/crater-browser-http@0.19.0",
  "moonbit-community/ucd@0.5.0",
  "moonbit-community/normalization@0.5.0",
  "moonbit-community/idna@0.5.0",
  "moonbit-community/bidi@0.5.0",
  "moonbit-community/punycode@0.5.0",
  "mizchi/experimental_crypto@0.0.2",
  "cc06b/mooncry@0.44.0",
  "caijiewei295/tzif-engine@0.1.0",
  "moonbit-community/flate@0.7.3",
  "hustcer/fbr@0.8.2",
}

readme = "README.md"

repository = "https://github.com/ZSeanYves/MoonbitHTTP"

license = "Apache-2.0"

keywords = [ "http", "http1", "http2", "protocol" ]

description = "Modular HTTP protocol codecs and connection utilities for MoonBit."
